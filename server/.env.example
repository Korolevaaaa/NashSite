# Telegram-группа для заявок (те же значения что на старом сайте)
TG_BOT_TOKEN=
TG_CHAT_ID=
# Прокси для api.telegram.org — нужен если сервер в РФ. Формат: http://user:pass@host:port
TG_PROXY=

# GigaChat (AI-бот в чате)
GIGACHAT_AUTH_KEY=

# Почта — дублирование заявок. Если не задано, письма просто пропускаются.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
